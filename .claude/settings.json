{
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push *:main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-push.py\"",
            "statusMessage": "Checking for git push"
          }
        ]
      }
    ]
  }
}
